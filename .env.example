# Quotex Account Credentials
# (If you don't provide SSID, pyquotex will automatically authenticate using email and password)
QUOTEX_EMAIL=your_email@example.com
QUOTEX_PASSWORD=your_password_here

# Asset and Timeframe
ASSET=EURUSD_otc
TIMEFRAME=60
CANDLE_COUNT=100

# Strategy Parameters
EMA_PERIOD=200
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
